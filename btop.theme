# ────────────────────────────────────────────────────────────
# BTOP THEME — Tokyo Night (fixed contrast)
# ────────────────────────────────────────────────────────────

# Empty = use terminal background (for blur/transparency)
theme[main_bg]=""

# Main text
theme[main_fg]="#c0caf5"

# Titles
theme[title]="#7aa2f7"

# Highlight text
theme[hi_fg]="#7dcfff"

# Selected row
theme[selected_bg]="#364a82"
theme[selected_fg]="#c0caf5"

# Inactive/dim text
theme[inactive_fg]="#565f89"

# Box borders
theme[cpu_box]="#3d59a1"
theme[mem_box]="#9d7cd8"
theme[net_box]="#41a6b5"
theme[proc_box]="#3d59a1"
theme[div_line]="#3b4261"

# CPU graph — starts visible, ends bright blue
theme[cpu_start]="#1e3a5f"
theme[cpu_mid]="#4fc3f7"
theme[cpu_end]="#7aa2f7"

# Free memory graph
theme[free_start]="#1e3a5f"
theme[free_mid]="#4fc3f7"
theme[free_end]="#7aa2f7"

# Used memory graph — purple range
theme[mem_start]="#2d1b69"
theme[mem_mid]="#9d7cd8"
theme[mem_end]="#bb9af7"

# Network graph
theme[net_start]="#1e3a5f"
theme[net_mid]="#41a6b5"
theme[net_end]="#7dcfff"

# Temperature — blue to red
theme[temp_start]="#7aa2f7"
theme[temp_mid]="#e0af68"
theme[temp_end]="#f7768e"

# Process CPU bars
theme[proc_misc]="#bb9af7"

# Upload/download graphs
theme[upload_start]="#1e3a5f"
theme[upload_end]="#7aa2f7"
theme[download_start]="#2d1b69"
theme[download_end]="#bb9af7"
