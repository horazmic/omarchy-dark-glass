# ────────────────────────────────────────────────────────────
# BTOP THEME — Obsidian Glass
# ────────────────────────────────────────────────────────────

# Empty = use terminal background (for blur/transparency)
theme[main_bg]=""

# Main text
theme[main_fg]="#f2f2f2"

# Titles
theme[title]="#d8d8d8"

# Highlight text
theme[hi_fg]="#ffffff"

# Selected row
theme[selected_bg]="#2a2a2a"
theme[selected_fg]="#ffffff"

# Inactive/dim text
theme[inactive_fg]="#9f9f9f"

# Box borders
theme[cpu_box]="#666666"
theme[mem_box]="#7a7a7a"
theme[net_box]="#8a8a8a"
theme[proc_box]="#666666"
theme[div_line]="#333333"

# CPU graph
theme[cpu_start]="#4f4f4f"
theme[cpu_mid]="#787878"
theme[cpu_end]="#b0b0b0"

# Free memory graph
theme[free_start]="#353535"
theme[free_mid]="#666666"
theme[free_end]="#9d9d9d"

# Used memory graph
theme[mem_start]="#404040"
theme[mem_mid]="#727272"
theme[mem_end]="#b2b2b2"

# Network graph
theme[net_start]="#3b3b3b"
theme[net_mid]="#6f6f6f"
theme[net_end]="#a6a6a6"

# Temperature: neutral to warm
theme[temp_start]="#7a7a7a"
theme[temp_mid]="#b08f66"
theme[temp_end]="#b67575"

# Process CPU bars
theme[proc_misc]="#8a8a8a"

# Upload/download graphs
theme[upload_start]="#454545"
theme[upload_end]="#9b9b9b"
theme[download_start]="#3d3d3d"
theme[download_end]="#8a8a8a"
